IMMICH_VERSION=release
UPLOAD_LOCATION=./data/upload
DB_DATA_LOCATION=./data/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Optional test-user overrides. Defaults create an ephemeral account.
IMMICH_TEST_EMAIL=loadtest@example.invalid
IMMICH_TEST_PASSWORD=LoadTestPassword123!
IMMICH_TEST_NAME="Ephemeral Load Test"

# Generated automatically by scripts/run-load-test.sh.
IMMICH_API_KEY=

IMMICH_PORT=2283
CADVISOR_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
