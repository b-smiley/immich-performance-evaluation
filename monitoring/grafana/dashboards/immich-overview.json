{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service!=\"\"}[1m])) * 100",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "title": "Container CPU usage (% of one core)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_service!=\"\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "title": "Memory: working set",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_usage_bytes{container_label_com_docker_compose_service!=\"\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "title": "Memory: usage including cache",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "count(container_last_seen{container_label_com_docker_compose_service!=\"\"})",
          "legendFormat": "running containers",
          "refId": "A"
        }
      ],
      "title": "Running container count",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Time from the upload being sent to the first response byte, measured by k6 and including network round-trip time. Each line is one workload kind.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "k6_http_req_waiting_p95",
          "legendFormat": "{{kind}} p95",
          "refId": "A"
        }
      ],
      "title": "API latency: k6 waiting time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Mean statement execution time from pg_stat_statements.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_statements_seconds_total{job=\"postgres\"}[1m])) / sum(rate(pg_stat_statements_calls_total{job=\"postgres\"}[1m])) * 1000",
          "legendFormat": "mean",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL latency: mean query time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Mean command execution time inside Redis, excluding the exporter's own commands.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(redis_commands_duration_seconds_total{job=\"redis\",cmd!~\"info|latency\\\\|.*|client\\\\|list|config\\\\|.*|slowlog\\\\|.*|commandlog\\\\|.*|command\\\\|.*\"}[1m])) / sum(rate(redis_commands_total{job=\"redis\",cmd!~\"info|latency\\\\|.*|client\\\\|list|config\\\\|.*|slowlog\\\\|.*|commandlog\\\\|.*|command\\\\|.*\"}[1m])) * 1000",
          "legendFormat": "mean",
          "refId": "A"
        }
      ],
      "title": "Redis latency: mean command time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "CPU of the API and background worker Node processes and the exiftool processes the worker starts, from process-exporter every 5 seconds. ffmpeg (with ffprobe) comes from the CPU of the worker's finished children, so each process counts when it exits, and a long transcode shows as one burst at its end.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total[1m])) * 100",
          "legendFormat": "{{groupname}}",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(immich_worker_finished_children_cpu_seconds_total[1m])) - (sum(rate(immich_worker_finished_tracked_children_cpu_seconds_total[1m])) or vector(0))) * 100",
          "legendFormat": "ffmpeg",
          "refId": "B"
        }
      ],
      "title": "Process CPU inside immich-server (% of one core)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Successful background jobs per second, by job, from Immich's worker telemetry.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (immich_job) (rate(immich_jobs_total{job=\"immich-worker\",outcome=\"success\"}[1m]))",
          "legendFormat": "{{immich_job}}",
          "refId": "A"
        }
      ],
      "title": "Worker jobs completed per second",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Jobs the background worker is running at once, by queue, from Immich's worker telemetry.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "immich_queue_jobs{job=\"immich-worker\",state=\"active\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Worker active jobs by queue",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Seconds per second the background worker spends in each internal step (repository method), from Immich's worker telemetry. The event and job repositories are left out because they wrap the other steps. Calls overlap, so the total can exceed 1.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (repository, method) (rate(immich_repository_duration_ms_sum{job=\"immich-worker\",repository!~\"event|job\"}[1m])) / 1000)",
          "legendFormat": "{{repository}}.{{method}}",
          "refId": "A"
        }
      ],
      "title": "Worker time by step (top 10)",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": [
    "immich",
    "containers"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Immich Overview",
  "uid": "immich-overview",
  "version": 2
}
